<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Become.Views.ForgotPasswordPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ContentPage.Resources>
        <Color x:Key="Primary">#1F3C88</Color>
        <Color x:Key="Title">#1E2A5A</Color>
        <Color x:Key="TextMuted">#7B8499</Color>
        <Color x:Key="FieldBackground">#F6F8FC</Color>
        <Color x:Key="FieldStroke">#E6EAF2</Color>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Title}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Aspect" Value="Uniform" />
            <Setter Property="WidthRequest" Value="18" />
            <Setter Property="HeightRequest" Value="18" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto" Padding="28,20,28,24">

        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <!-- Retour à la connexion -->
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Start">
                    <Path Style="{StaticResource Icon}"
                          Stroke="{StaticResource Primary}"
                          WidthRequest="16"
                          HeightRequest="16"
                          Data="M19,12 H5 M12,19 L5,12 L12,5" />
                    <Label Text="Retour à la connexion"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer x:Name="BackTap" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>

                <!-- Logo -->
                <Image Source="become_logo.png"
                       HeightRequest="72"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       Margin="0,24,0,0" />
                <Label Text="Become"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#1A1F2B"
                       HorizontalOptions="Center"
                       Margin="0,4,0,0" />
                <Label Text="Tes objectifs. Ta progression."
                       FontSize="10"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center" />

                <Label Text="Mot de passe oublié ?"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Title}"
                       Margin="0,28,0,0" />
                <Label Text="Indiquez l'adresse e-mail associée à votre compte. Nous vous enverrons un lien pour réinitialiser votre mot de passe."
                       FontSize="13"
                       TextColor="{StaticResource TextMuted}"
                       Margin="0,8,0,0" />

                <!-- Adresse e-mail -->
                <Label Text="Adresse e-mail"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Title}"
                       Margin="0,24,0,8" />
                <Border BackgroundColor="{StaticResource FieldBackground}"
                        Stroke="{StaticResource FieldStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="14,2"
                        HeightRequest="52">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Path Style="{StaticResource Icon}"
                              Data="M4,4 H20 A2,2 0 0 1 22,6 V18 A2,2 0 0 1 20,20 H4 A2,2 0 0 1 2,18 V6 A2,2 0 0 1 4,4 Z M22,6 L12,13 L2,6" />
                        <Entry Grid.Column="1"
                               x:Name="EmailEntry"
                               Placeholder="vous@exemple.com"
                               Keyboard="Email"
                               FontSize="14"
                               TextColor="{StaticResource Title}"
                               PlaceholderColor="{StaticResource TextMuted}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Button x:Name="SendLinkButton"
                        Text="Envoyer le lien de réinitialisation"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="{StaticResource Primary}"
                        CornerRadius="12"
                        HeightRequest="52"
                        Margin="0,20,0,0" />

                <Label Text="Pensez à vérifier vos courriers indésirables."
                       FontSize="12"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,16,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Pied de page -->
        <HorizontalStackLayout Grid.Row="1" Spacing="6" HorizontalOptions="Center">
            <Path Style="{StaticResource Icon}"
                  Stroke="{StaticResource TextMuted}"
                  WidthRequest="13"
                  HeightRequest="13"
                  Data="M12,22 C12,22 20,18 20,12 V5 L12,2 L4,5 V12 C4,18 12,22 12,22 Z" />
            <Label Text="Vos objectifs restent personnels."
                   FontSize="11"
                   TextColor="{StaticResource TextMuted}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
