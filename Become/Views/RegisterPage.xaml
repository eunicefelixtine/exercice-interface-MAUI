<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Become.Views.RegisterPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ContentPage.Resources>
        <Color x:Key="Primary">#1F3C88</Color>
        <Color x:Key="Title">#1E2A5A</Color>
        <Color x:Key="TextMuted">#7B8499</Color>
        <Color x:Key="FieldBackground">#F6F8FC</Color>
        <Color x:Key="FieldStroke">#E6EAF2</Color>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Title}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Aspect" Value="Uniform" />
            <Setter Property="WidthRequest" Value="18" />
            <Setter Property="HeightRequest" Value="18" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Title}" />
        </Style>

        <Style x:Key="Field" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource FieldBackground}" />
            <Setter Property="Stroke" Value="{StaticResource FieldStroke}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="14,2" />
            <Setter Property="HeightRequest" Value="52" />
        </Style>

        <Style x:Key="FieldEntry" TargetType="Entry">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource Title}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="28,32,28,24" Spacing="0">

            <!-- Logo -->
            <Image Source="become_logo.png"
                   HeightRequest="72"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />
            <Label Text="Become"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#1A1F2B"
                   HorizontalOptions="Center"
                   Margin="0,4,0,0" />
            <Label Text="Tes objectifs. Ta progression."
                   FontSize="10"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalOptions="Center" />

            <Label Text="Votre prochain chapitre."
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Title}"
                   Margin="0,24,0,0" />
            <Label Text="Créez votre compte et avancez à votre rythme."
                   FontSize="13"
                   TextColor="{StaticResource TextMuted}"
                   Margin="0,8,0,0" />

            <!-- Prénom -->
            <Label Text="Prénom" Style="{StaticResource FieldLabel}" Margin="0,22,0,8" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Path Style="{StaticResource Icon}"
                          Data="M20,21 V19 A4,4 0 0 0 16,15 H8 A4,4 0 0 0 4,19 V21 M16,7 A4,4 0 1 1 8,7 A4,4 0 1 1 16,7 Z" />
                    <Entry Grid.Column="1"
                           x:Name="FirstNameEntry"
                           Style="{StaticResource FieldEntry}"
                           Placeholder="Votre prénom" />
                </Grid>
            </Border>

            <!-- Adresse e-mail -->
            <Label Text="Adresse e-mail" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Path Style="{StaticResource Icon}"
                          Data="M4,4 H20 A2,2 0 0 1 22,6 V18 A2,2 0 0 1 20,20 H4 A2,2 0 0 1 2,18 V6 A2,2 0 0 1 4,4 Z M22,6 L12,13 L2,6" />
                    <Entry Grid.Column="1"
                           x:Name="EmailEntry"
                           Style="{StaticResource FieldEntry}"
                           Placeholder="vous@exemple.com"
                           Keyboard="Email" />
                </Grid>
            </Border>

            <!-- Mot de passe -->
            <Label Text="Mot de passe" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Path Style="{StaticResource Icon}"
                          Data="M5,11 H19 A2,2 0 0 1 21,13 V20 A2,2 0 0 1 19,22 H5 A2,2 0 0 1 3,20 V13 A2,2 0 0 1 5,11 Z M7,11 V7 A5,5 0 0 1 17,7 V11" />
                    <Entry Grid.Column="1"
                           x:Name="PasswordEntry"
                           Style="{StaticResource FieldEntry}"
                           Placeholder="••••••••••••"
                           IsPassword="True" />
                </Grid>
            </Border>

            <!-- Indicateur de robustesse -->
            <HorizontalStackLayout Spacing="6" Margin="0,12,0,0">
                <Path Style="{StaticResource Icon}"
                      Stroke="{StaticResource TextMuted}"
                      WidthRequest="12"
                      HeightRequest="12"
                      Data="M20,6 L9,17 L4,12" />
                <Label Text="8 caractères minimum • Mot de passe fort"
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Conditions -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" Margin="-6,6,0,0">
                <CheckBox x:Name="TermsCheckBox"
                          Color="{StaticResource Primary}"
                          VerticalOptions="Start" />
                <Label Grid.Column="1"
                       Text="J'accepte les conditions d'utilisation et la politique de confidentialité."
                       FontSize="12"
                       TextColor="{StaticResource TextMuted}"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Créer mon compte -->
            <Grid Margin="0,14,0,0" HeightRequest="52">
                <Button x:Name="RegisterButton"
                        BackgroundColor="{StaticResource Primary}"
                        CornerRadius="12" />
                <HorizontalStackLayout Spacing="10"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True">
                    <Path Style="{StaticResource Icon}"
                          Stroke="White"
                          Data="M5,12 H19 M12,5 L19,12 L12,19" />
                    <Label Text="Créer mon compte"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <Label HorizontalOptions="Center" Margin="0,18,0,0" FontSize="13">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Déjà un compte ? " TextColor="{StaticResource TextMuted}" />
                        <Span Text="Se connecter" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer x:Name="LoginTap" />
                </Label.GestureRecognizers>
            </Label>

            <Label Text="✨ Pas besoin d'être parfait. Juste de commencer."
                   FontSize="12"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalOptions="Center"
                   Margin="0,22,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
