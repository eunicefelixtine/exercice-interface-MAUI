<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Become.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ContentPage.Resources>
        <Color x:Key="Primary">#1F3C88</Color>
        <Color x:Key="Title">#1E2A5A</Color>
        <Color x:Key="TextMuted">#7B8499</Color>
        <Color x:Key="FieldBackground">#F6F8FC</Color>
        <Color x:Key="FieldStroke">#E6EAF2</Color>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Title}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Aspect" Value="Uniform" />
            <Setter Property="WidthRequest" Value="18" />
            <Setter Property="HeightRequest" Value="18" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Title}" />
        </Style>

        <Style x:Key="Field" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource FieldBackground}" />
            <Setter Property="Stroke" Value="{StaticResource FieldStroke}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="14,2" />
            <Setter Property="HeightRequest" Value="52" />
        </Style>

        <Style x:Key="FieldEntry" TargetType="Entry">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource Title}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="28,40,28,24" Spacing="0">

            <!-- Logo -->
            <Image Source="become_logo.png"
                   HeightRequest="72"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />
            <Label Text="Become"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#1A1F2B"
                   HorizontalOptions="Center"
                   Margin="0,4,0,0" />
            <Label Text="Tes objectifs. Ta progression."
                   FontSize="10"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalOptions="Center" />

            <Label Text="Heureux de vous revoir."
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Title}"
                   Margin="0,28,0,0" />
            <Label Text="Un petit pas aujourd'hui. Un grand changement demain."
                   FontSize="13"
                   TextColor="{StaticResource TextMuted}"
                   Margin="0,8,0,0" />

            <!-- Adresse e-mail -->
            <Label Text="Adresse e-mail" Style="{StaticResource FieldLabel}" Margin="0,24,0,8" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Path Style="{StaticResource Icon}"
                          Data="M4,4 H20 A2,2 0 0 1 22,6 V18 A2,2 0 0 1 20,20 H4 A2,2 0 0 1 2,18 V6 A2,2 0 0 1 4,4 Z M22,6 L12,13 L2,6" />
                    <Entry Grid.Column="1"
                           x:Name="EmailEntry"
                           Style="{StaticResource FieldEntry}"
                           Placeholder="vous@exemple.com"
                           Keyboard="Email" />
                </Grid>
            </Border>

            <!-- Mot de passe -->
            <Label Text="Mot de passe" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Path Style="{StaticResource Icon}"
                          Data="M5,11 H19 A2,2 0 0 1 21,13 V20 A2,2 0 0 1 19,22 H5 A2,2 0 0 1 3,20 V13 A2,2 0 0 1 5,11 Z M7,11 V7 A5,5 0 0 1 17,7 V11" />
                    <Entry Grid.Column="1"
                           x:Name="PasswordEntry"
                           Style="{StaticResource FieldEntry}"
                           Placeholder="••••••••••••"
                           IsPassword="True" />
                </Grid>
            </Border>

            <Label Text="Mot de passe oublié ?"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="End"
                   Margin="0,14,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer x:Name="ForgotPasswordTap" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Se connecter -->
            <Grid Margin="0,16,0,0" HeightRequest="52">
                <Button x:Name="LoginButton"
                        BackgroundColor="{StaticResource Primary}"
                        CornerRadius="12" />
                <HorizontalStackLayout Spacing="10"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True">
                    <Path Style="{StaticResource Icon}"
                          Stroke="White"
                          Data="M5,12 H19 M12,5 L19,12 L12,19" />
                    <Label Text="Se connecter"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <Label Text="ou"
                   FontSize="12"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalOptions="Center"
                   Margin="0,16" />

            <!-- Continuer avec Apple -->
            <Button x:Name="AppleButton"
                    Text="Continuer avec Apple"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Title}"
                    BackgroundColor="White"
                    BorderColor="{StaticResource FieldStroke}"
                    BorderWidth="1"
                    CornerRadius="12"
                    HeightRequest="52" />

            <Label HorizontalOptions="Center" Margin="0,24,0,0" FontSize="13">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Nouveau sur Become ? " TextColor="{StaticResource TextMuted}" />
                        <Span Text="Créer un compte" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer x:Name="RegisterTap" />
                </Label.GestureRecognizers>
            </Label>

            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,16,0,0">
                <Path Style="{StaticResource Icon}"
                      Stroke="{StaticResource TextMuted}"
                      WidthRequest="13"
                      HeightRequest="13"
                      Data="M12,22 C12,22 20,18 20,12 V5 L12,2 L4,5 V12 C4,18 12,22 12,22 Z" />
                <Label Text="Vos objectifs restent personnels."
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
